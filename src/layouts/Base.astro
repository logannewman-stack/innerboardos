---
/**
 * The page shell (IOS_SPEC 1.5), the Suite's with three changes. `theme`
 * picks the page's first tone, written server side on <html data-theme> so
 * the first paint is right before the script runs: "navy" on the homepage,
 * "cream" on the legal pages. `navStart` seeds the header tone ("dark" on
 * the homepage, "light" on the legal pages).
 */
import "../styles/global.css";
import "../styles/motion.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/links";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  /** The page's own path, for the canonical URL. */
  path?: string;
  image?: string;
  theme?: "cream" | "navy";
  navStart?: "light" | "dark";
}
const { title, description = SITE.description, path = "/", image = "/og-image.png", theme = "cream", navStart = "light" } = Astro.props;
const color = theme === "navy" ? "#0d1a2d" : "#f4efe4";
const canonical = new URL(path, SITE.url).toString();
const imageUrl = new URL(image, SITE.url).toString();
---
<!doctype html>
<html lang="en" class="no-js" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={color} />
    <meta name="nav-start" content={navStart} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.remove("no-js");document.documentElement.classList.add("js");</script>
    <style is:inline>@view-transition { navigation: auto; }</style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "InnerBoard",
      url: SITE.url,
      founder: { "@type": "Person", name: SITE.founder },
      sameAs: ["https://innerboardsuite.com", "https://practiceinnerboard.com"]
    })} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
