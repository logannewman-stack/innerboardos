---
import Base from "../layouts/Base.astro";
import { LINKS } from "../config/links";
const updated = "October 19, 2026";
---
<Base title="Terms of use · InnerBoard IOS" description="The terms for this site, in plain words. These terms cover innerboardos.com. You may read, link to and share the pages on this site." path="/terms" theme="cream" navStart="light">
  <article class="wrap prose-ib io-legal">
    <p class="eyebrow">Terms of use</p>
    <h1 class="t-m">The terms for this site, in plain words.</h1>
    <p class="t-cap io-legal-date">Last updated {updated}. These terms cover innerboardos.com. Practice by InnerBoard, the app, has its own terms inside the app.</p>

    <h2>Using the site</h2>
    <p>You may read, link to and share the pages on this site. You may not copy the frameworks, diagrams, curriculum descriptions or book excerpts for commercial use without written permission from InnerBoard.</p>

    <h2>What the content is</h2>
    <p>Everything here describes an approach to leadership and organizational development. It is educational. It is not legal, financial, medical or psychological advice, and reading it does not create a client relationship with InnerBoard.</p>

    <h2>The assessment</h2>
    <p>The Company OS Score is a reflection tool, not a clinical or financial instrument. Its result is produced from your own answers. Decisions you make from it are yours.</p>

    <h2>Links to other places</h2>
    <p>Buttons on this site open Practice by InnerBoard, InnerBoardSuite.com and, when you ask to buy the book, a retailer. Each of those has its own terms.</p>

    <h2>Ownership</h2>
    <p>InnerBoard, InnerBoard IOS, Practice by InnerBoard, the InnerBoard mark and the names of the frameworks are the property of InnerBoard. Replaceable is the work of Leah Roling.</p>

    <h2>Liability</h2>
    <p>The site is provided as it is. To the extent the law allows, InnerBoard is not liable for loss arising from your use of the site or your reliance on its content.</p>

    <h2>Questions</h2>
    <p>Write to <a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a>.</p>
    <p class="t-cap io-legal-note">Written in plain language; to be reviewed by counsel before launch.</p>
  </article>
</Base>
<style>
  /* The legal page (IOS_SPEC 2.12): the system's prose rules; only the column and its padding are set here. */
  .io-legal { max-width: 40em; padding-top: calc(var(--nav-h) + 64px); padding-bottom: var(--sec); }
  .io-legal h1 { margin-top: 0; }
  /* The date line and the closing note at 14 px (audit 2, P2 21). */
  .io-legal p.t-cap { font-size: 14px; line-height: 1.45; color: var(--fg-3); }
  /* The eyebrow keeps its own size and colour against the prose paragraph rule. */
  .io-legal p.eyebrow { margin-top: 0; font-size: var(--fs-eyebrow); line-height: 1; color: var(--fg-3); }
  .io-legal-date { margin-top: 12px; }
  .io-legal-note { margin-top: 28px; }
</style>
