---
/**
 * innerboardos.com
 *
 * Built to the InnerBoard IOS Website Development & Copy Handoff (October
 * 15, 2026). The copy below is that document's, section by section, in its
 * order. The visual direction is the approved full-page reference: navy,
 * cream and muted gold, two distinct diagrams, the book, a photograph in the
 * hero and a panorama at the close.
 */
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import CircleDiagram from "../components/CircleDiagram.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import AssessmentPhone from "../components/AssessmentPhone.astro";
import Mountains from "../components/Mountains.astro";
import BookCover from "../components/BookCover.astro";
import { LINKS, SITE } from "../config/links";

const title = "InnerBoard IOS · The people operating system for high-performing organizations";
const description =
  "Growth doesn't have to depend on you. InnerBoard IOS develops the confidence, capability, and ownership of the people you already pay. Start with your Company OS Score.";

const challenges = [
  { icon: "people", name: "Too Much Depends on Too Few", body: "A handful of people carry the standards, decisions, and responsibility for everyone else." },
  { icon: "sun", name: "Execution Isn't Consistent", body: "You have the systems. But getting people to follow through shouldn't require constant reminders." },
  { icon: "bars", name: "Your People Aren't Growing Fast Enough", body: "The business is growing, but your team's judgment and ownership aren't keeping pace." }
];

const outcomes = [
  { icon: "own", name: "More Ownership", body: "People who understand what's expected and take responsibility for their decisions, actions, and results." },
  { icon: "check", name: "Stronger Execution", body: "Teams that follow through consistently, solve problems, and turn expectations into daily habits." },
  { icon: "up", name: "Greater Leadership Capacity", body: "Managers and team members who grow the self-trust and skill to lead themselves and others." },
  { icon: "door", name: "Less Founder Dependency", body: "People who can make decisions, solve problems, and execute without everything coming back to you." },
  { icon: "culture", name: "A Stronger Culture", body: "An environment where people understand what's expected, trust one another, and take responsibility for their contribution." },
  { icon: "diamond", name: "Greater Enterprise Value", body: "The organizational strength, leadership capacity, and consistency that support sustainable growth and long-term business value." }
];

const audiences = [
  { name: "Founders and Owners", body: "You've built a successful business, but too much still depends on you. You want more freedom, stronger leaders, and a company that can grow without your constant involvement." },
  { name: "CEOs and Executive Teams", body: "You have ambitious goals, operational systems, and talented people. You want a more consistent way to grow your people's skill, strengthen follow-through, and align everyday behavior with organizational performance." },
  { name: "Growing Organizations", body: "You're adding people, expanding responsibilities, and increasing complexity. You want to develop the leadership and cultural capacity to grow without losing the standards that made the business successful." },
  { name: "Organizations Preparing for Their Next Chapter", body: "Whether you're scaling, expanding, strengthening your leadership team, or preparing for a future transition, you want a business built on capability rather than dependency." }
];
---
<Base title={title} description={description} path="/">
  <!-- ── 1. Hero ──────────────────────────────────────────────────────── -->
  <section id="ios" class="on-navy relative bg-navy text-cream overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="absolute inset-0 grid-lines" aria-hidden="true"></div>
    <div class="hero-photo absolute inset-y-0 right-0 w-full lg:w-[58%]" aria-hidden="true">
      <picture>
        <source type="image/webp" srcset="/images/leah-hero-sm.webp 900w, /images/leah-hero.webp 1800w" sizes="(min-width: 1024px) 58vw, 100vw" />
        <img src="/images/leah-hero.jpg" srcset="/images/leah-hero-sm.jpg 900w, /images/leah-hero.jpg 1800w" sizes="(min-width: 1024px) 58vw, 100vw" alt="" width="1800" height="1320" fetchpriority="high" decoding="async" class="w-full h-full object-cover object-[70%_30%]" />
      </picture>
      <div class="absolute inset-0 hero-fade"></div>
    </div>
    <div class="wrap relative pt-[128px] sm:pt-[160px] pb-20 sm:pb-28 min-h-[92vh] flex items-center">
      <div class="grid gap-10 lg:grid-cols-[1fr_0.9fr] w-full">
        <div class="reveal is-in max-w-[620px]">
          <p class="eyebrow">InnerBoard Operating System</p>
          <h1 class="mt-5 text-[46px] sm:text-[64px] lg:text-[76px] leading-[0.98]" data-words>
            Growth doesn't have to depend <em class="text-gold-2">on you.</em>
          </h1>
          <p class="mt-6 font-display text-[21px] sm:text-[25px] leading-[1.25] text-cream">You built the business. Now build the people who can grow it.</p>
          <p class="mt-5 text-[16.5px] sm:text-[17.5px] leading-relaxed text-cream-muted max-w-[560px]">
            Your business has an operating system. Your people need one too.
          </p>
          <p class="mt-3 text-[16.5px] sm:text-[17.5px] leading-relaxed text-cream-muted max-w-[560px]">
            InnerBoard IOS helps you accelerate the value of the people you already pay by developing the confidence, capability, and ownership to do their best work.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a href={LINKS.score} class="btn btn-gold" data-passthrough data-event="assessment_click" data-event-location="hero">Get Your Company OS Score <Arrow /></a>
            <a href={LINKS.talk} class="btn btn-outline-cream" data-event="consultation_click" data-event-location="hero">Talk to Our Team</a>
          </div>
          <p class="mt-4 text-[13.5px] text-cream-faint">Take the assessment and receive your Company OS Gap Report.</p>
        </div>
        <div class="reveal is-in relative hidden lg:flex items-end justify-end" style="--d:200ms">
          <ul class="text-right text-[12px] font-semibold uppercase tracking-[0.22em] text-cream/80 space-y-2 border-r border-gold-2/60 pr-5 mb-6">
            {["People.", "Capability.", "Culture.", "Results.", "Valuation."].map((w) => <li>{w}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. The challenge ─────────────────────────────────────────────── -->
  <section id="challenge" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
        <div class="reveal">
          <p class="eyebrow">The challenge</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px] text-navy">You've built a successful business. <em>Why does it still need you for everything?</em></h2>
          <p class="mt-6 text-[16.5px] leading-relaxed text-ink-muted">You've invested in people, systems, and processes. Yet too many decisions still come back to you.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-muted">You're the one setting the standard, solving the problems, and making sure things get done.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-muted">And as your business grows, so does the weight of carrying it.</p>
        </div>
        <div class="reveal grid gap-px bg-line border border-line rounded-[var(--radius-card)] overflow-hidden sm:grid-cols-3" style="--d:120ms">
          {challenges.map((c) => (
            <div class="bg-cream-3 p-6 sm:p-7">
              <span class="text-gold"><Icon name={c.icon} class="w-8 h-8" /></span>
              <h3 class="mt-4 text-[20px] leading-[1.2] text-navy">{c.name}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal mt-14 hairline pt-10 grid gap-6 lg:grid-cols-[1fr_1.1fr]">
        <p class="eyebrow">What it costs</p>
        <div>
          <p class="font-display text-[19px] sm:text-[22px] leading-[1.45] text-ink">
            The cost doesn't always appear as a line item on your financial statements. It shows up in decisions that never get made. Problems that keep coming back. Opportunities that go unnoticed. Leaders who spend their days following up instead of moving the business forward. And a founder who remains essential to far too much.
          </p>
          <p class="mt-6 text-[16.5px] leading-relaxed text-ink-muted">The opportunity isn't simply to get more out of your people. It's to develop more of what they're capable of bringing to the business.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. The solution ──────────────────────────────────────────────── -->
  <section id="solution" class="on-navy bg-navy text-cream relative overflow-hidden aurora" data-glow>
    <span class="aurora-2"></span>
    <div class="absolute inset-0 grid-lines opacity-70" aria-hidden="true"></div>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div class="reveal">
          <p class="eyebrow">The solution</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px]">A people operating system for <em>high-performing organizations.</em></h2>
          <p class="mt-6 text-[16.5px] leading-relaxed text-cream-muted">You already have systems for how your business operates. InnerBoard IOS gives you a system for how your people operate.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-cream-muted">Most organizations invest heavily in processes, technology, and operational efficiency. But the people responsible for executing those systems are often left to figure out how to lead themselves, manage their emotions, build confidence, take ownership, and work effectively with others.</p>
          <p class="mt-3 font-display text-[21px] text-cream">InnerBoard IOS changes that.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-cream-muted">Your business systems tell people what needs to happen. InnerBoard IOS develops how people show up to make it happen.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-cream-muted">Designed to work alongside the systems, training, and leadership development you've already invested in, IOS helps people turn what they know into what they consistently do.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-cream-muted">InnerBoard IOS builds the ownership, judgment, and follow-through of the people you already employ, creating the conditions for stronger execution and better business results.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-cream-muted">It brings people development into the way your organization operates, rather than treating it as another training event.</p>
          <a href="#how-it-works" class="btn btn-gold mt-8">See How InnerBoard IOS Works <Arrow /></a>
        </div>
        <div class="reveal lg:pt-10" style="--d:140ms">
          <p class="font-display text-[30px] sm:text-[40px] leading-[1.12] text-cream">Your business has an operating system. <em class="text-gold-2">Your people need one too.</em></p>
          <p class="mt-6 text-[15px] leading-relaxed text-cream-faint max-w-[460px]">Five links, in one direction. How people lead themselves becomes the culture; the culture produces the behavior; the behavior produces the results; the results set what the business is worth.</p>
        </div>
      </div>
      <div class="reveal mt-14 card-navy p-6 sm:p-10" style="--d:120ms">
        <CircleDiagram />
      </div>
    </div>
  </section>

  <!-- ── 4. How it works ──────────────────────────────────────────────── -->
  <section id="how-it-works" class="bg-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="reveal max-w-[720px]">
          <p class="eyebrow">The InnerBoard IOS workflow</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px] text-navy">Know where your people are. <em>Build what they're capable of becoming.</em></h2>
          <p class="mt-6 font-display text-[20px] text-ink">You can't develop what you don't understand.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-muted">InnerBoard IOS begins by helping organizations identify where their people are today, what their roles require, and where the greatest opportunities for growth exist. From there, it provides a continuous system for building skill, embedding new behaviors, and measuring progress.</p>
        </div>
      </div>
      <div class="mt-14"><WorkflowDiagram /></div>
      <div class="reveal mt-16 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div class="flex justify-center lg:justify-start" data-tilt="4">
          <AssessmentPhone />
        </div>
        <div>
          <p class="eyebrow">From insight to execution</p>
          <p class="mt-3 font-display text-[26px] sm:text-[32px] leading-[1.15] text-navy">One connected system. Continuous development. <em>Stronger execution.</em></p>
          <p class="mt-4 text-[13px] font-semibold uppercase tracking-[0.14em] text-gold-ink">Assess → Develop → Embed → Measure → Certify</p>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[520px]">The goal is not simply to help people learn more. It's to help them do their best work, every day.</p>
          <p class="mt-5 text-[13px] text-ink-faint max-w-[520px]">The phone is illustrative. The Company OS Score itself runs inside Practice by InnerBoard, scores in your browser, and sends your Company OS Gap Report.</p>
          <a href={LINKS.score} class="btn btn-navy mt-6" data-passthrough data-event="assessment_click" data-event-location="workflow">Get Your Company OS Score <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 5. The thinking behind IOS ───────────────────────────────────── -->
  <section id="book" class="bg-cream relative overflow-hidden">
    <div class="watermark w-[720px] h-[720px] -right-56 -top-40" aria-hidden="true"><Mark /></div>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div class="reveal flex justify-center lg:justify-start"><BookCover /></div>
        <div class="reveal" style="--d:120ms">
          <p class="eyebrow">The thinking behind InnerBoard IOS</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px] text-navy">The future of your business is <em>already in your people.</em></h2>
          <p class="mt-5 text-[14px] font-semibold uppercase tracking-[0.14em] text-ink-faint">Replaceable by Leah Roling</p>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">Replaceable explores what happens when organizations develop people who can think, lead, and contribute beyond the limits of their job descriptions.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">It's an invitation to rethink the relationship between leadership, human capability, and the value of a business.</p>
          <p class="mt-6 font-display text-[21px] sm:text-[23px] leading-[1.3] text-ink max-w-[560px]">What if your greatest opportunity for growth is already on your payroll?</p>
          <p class="mt-4 text-[16.5px] leading-relaxed text-ink-muted max-w-[560px]">You've invested in the people who make your business possible. Replaceable invites you to see what becomes possible when you invest just as intentionally in who they're capable of becoming. InnerBoard IOS provides a way to put that thinking into practice.</p>
          <a href={LINKS.book} class="btn btn-gold mt-8" data-event="book_click" data-event-location="book">Buy the Book <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. The outcome ───────────────────────────────────────────────── -->
  <section id="impact" class="on-navy bg-navy-2 text-cream relative overflow-hidden" data-glow>
    <div class="wrap relative py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div class="reveal">
          <p class="eyebrow">The outcome</p>
          <h2 class="mt-4 text-[34px] sm:text-[46px]">Your business becomes stronger when <em>more people can carry it.</em></h2>
          <p class="mt-6 font-display text-[21px] text-cream">Accelerate the value of the people you already pay.</p>
        </div>
        <div class="reveal space-y-3 text-[16.5px] leading-relaxed text-cream-muted" style="--d:120ms">
          <p>You've already invested in your team: their salaries, their benefits, their training, their time. But how much of their potential is your organization actually developing?</p>
          <p>InnerBoard IOS helps you strengthen the people you already have so they can contribute at a higher level. Not by asking them to work harder. By helping them grow into more.</p>
          <p>What changes when your people keep their heads under pressure, know their craft, and are all in on doing their best work? Managers who don't wait for you to solve every problem. Employees who understand their responsibilities and own their results. A culture where ownership doesn't have to be demanded. And a business that keeps performing, improving, and growing without your involvement in every decision.</p>
        </div>
      </div>
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {outcomes.map((o, i) => (
          <li class="reveal card-navy p-6 sm:p-7" style={`--d:${i * 70}ms`}>
            <span class="text-gold-2"><Icon name={o.icon} class="w-8 h-8" /></span>
            <h3 class="mt-4 text-[22px] text-cream">{o.name}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-cream-muted">{o.body}</p>
          </li>
        ))}
      </ul>
      <div class="reveal mt-12 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="font-display text-[20px] sm:text-[22px] leading-[1.35] text-cream max-w-[720px]">You don't necessarily need more people to create more value. You need to develop more of the potential in the people you already employ.</p>
          <p class="mt-3 text-[16px] text-cream-muted max-w-[720px]">The business you've built should create opportunity, not become another thing you can never step away from.</p>
        </div>
        <a href={LINKS.talk} class="btn btn-gold" data-event="consultation_click" data-event-location="impact">Talk to Our Team <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- ── 7. Who it's for ──────────────────────────────────────────────── -->
  <section id="who-its-for" class="bg-cream-2">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Built for organizations ready to grow</p>
        <h2 class="mt-4 text-[34px] sm:text-[46px] text-navy">You've built something valuable. <em>Now it's time to make it stronger.</em></h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted">InnerBoard IOS is designed for founders, CEOs, and leadership teams who recognize that their next stage of growth depends on developing the people already inside their organization.</p>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-2">
        {audiences.map((a, i) => (
          <li class="reveal card p-6 sm:p-8 border-l-[3px] border-l-gold" style={`--d:${i * 90}ms`}>
            <h3 class="text-[24px] text-navy">{a.name}</h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">{a.body}</p>
          </li>
        ))}
      </ul>
      <div class="reveal mt-12">
        <a href={LINKS.talk} class="btn btn-navy" data-event="consultation_click" data-event-location="who">Let's Talk About Your Organization <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- ── 8. Partners ──────────────────────────────────────────────────── -->
  <section id="partners" class="bg-cream">
    <div class="wrap py-20 sm:py-28">
      <div class="reveal card bg-cream-3 p-8 sm:p-12 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p class="eyebrow">Partners</p>
          <h2 class="mt-4 text-[32px] sm:text-[42px] text-navy">Your systems help businesses operate. <em>IOS helps their people execute.</em></h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-muted max-w-[600px]">InnerBoard IOS is designed to complement the work of consultants, coaches, and business-system implementers by developing the human capability behind organizational performance.</p>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-muted max-w-[600px]">Let's explore how we might work together to create greater value for the organizations you serve.</p>
        </div>
        <div class="lg:justify-self-end">
          <a href={LINKS.partner} class="btn btn-gold" data-event="partner_inquiry_click" data-event-location="partners">Explore a Partnership <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 9. Your next step ────────────────────────────────────────────── -->
  <section id="next-step" class="on-navy relative bg-navy text-cream overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true"><Mountains /></div>
    <div class="absolute inset-0 bg-navy/55" aria-hidden="true"></div>
    <div class="wrap relative py-24 sm:py-36">
      <div class="reveal max-w-[760px]">
        <p class="eyebrow">Let's build what's next</p>
        <h2 class="mt-4 text-[36px] sm:text-[52px]">You don't have to keep carrying <em>the business you've built.</em></h2>
        <p class="mt-6 text-[17px] leading-relaxed text-cream-muted max-w-[600px]">You've worked hard to create something valuable. When the people around you can help carry it, the business moves forward without needing you in every room.</p>
        <p class="mt-4 font-display text-[20px] sm:text-[22px] leading-[1.35] text-cream max-w-[600px]">Stronger people. Stronger execution. Less dependency on you. A business positioned to grow in value.</p>
        <p class="mt-4 text-[17px] leading-relaxed text-cream-muted max-w-[600px]">You built the business. Now build the people who can grow it.</p>
        <p class="mt-2 text-[17px] leading-relaxed text-cream-muted max-w-[600px]">Let's explore what InnerBoard IOS could make possible for your organization.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={LINKS.talk} class="btn btn-gold" data-event="consultation_click" data-event-location="next-step">Talk to Our Team <Arrow /></a>
          <a href={LINKS.score} class="btn btn-outline-cream" data-passthrough data-event="assessment_click" data-event-location="next-step">Get your Company OS Score</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final brand statement ────────────────────────────────────────── -->
  <section class="on-navy bg-navy text-cream border-t border-navy-line">
    <div class="wrap py-20 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <blockquote class="reveal">
          <p class="font-display text-[30px] sm:text-[42px] leading-[1.12] tracking-[-0.02em]">"When people learn to lead themselves, <em class="text-gold-2">everything else changes."</em></p>
          <footer class="mt-6 flex items-center gap-4">
            <img src="/images/leah-portrait.jpg" alt="" width="56" height="51" loading="lazy" decoding="async" class="w-14 h-14 rounded-full object-cover object-top ring-2 ring-gold-2/50" />
            <div class="text-[14px] text-cream-muted"><span class="font-semibold text-cream">{SITE.founder}</span><br />{SITE.founderTitle}</div>
          </footer>
        </blockquote>
        <div class="reveal lg:text-right" style="--d:120ms">
          <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-gold-2 leading-[2]">A more capable team.<br />A stronger culture.<br />A more valuable business.</p>
          <p class="mt-6 font-display text-[24px] text-cream">InnerBoard IOS</p>
          <p class="mt-1 text-[14px] text-cream-muted">The people operating system for high-performing organizations.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-fade { background: linear-gradient(to right, var(--color-navy) 0%, rgba(13,26,45,0.92) 22%, rgba(13,26,45,0.45) 55%, rgba(13,26,45,0.15) 100%); }
  @media (min-width: 1024px) {
    .hero-fade { background: linear-gradient(to right, var(--color-navy) 0%, rgba(13,26,45,0.85) 18%, rgba(13,26,45,0.1) 60%, rgba(13,26,45,0.05) 100%), linear-gradient(to top, var(--color-navy) 0%, transparent 35%); }
  }
  @media (max-width: 1023px) {
    .hero-photo { opacity: 0.55; }
    .hero-fade { background: linear-gradient(to bottom, rgba(13,26,45,0.75), rgba(13,26,45,0.9) 60%, var(--color-navy) 100%); }
  }
</style>
