---
/**
 * Diagram 1, the philosophy (IOS_SPEC 2.3): five hairline rings interlocking
 * around a lit centre, engraved rather than illustrated, and a single orbit
 * that the reader draws by scrolling, lighting each definition in the legend
 * as it passes that ring. Two stacked SVGs share one viewBox: A draws the
 * rings on enter (1.7.14), B is the scroll drawn orbit that lights the rows
 * of #phil-rows. As the orbit reaches a ring the ring lights with its row
 * (steel to soft steel, a heavier line; no fill, so the overlaps stay
 * readable and every colour is a solid brand book hex); once all five are lit
 * a slow brightening walks round them in the orbit's order, and the centre breathes (the client, October 24: "Can this be animated?").
 * The five names and IOS are the only words in the drawing;
 * the definitions are the brief's, in the legend. Separate from the workflow
 * by design. The page places the two blocks on the grid.
 */
const nodes = [
  { name: "Leadership", def: "How every person leads themselves and influences others." },
  { name: "Culture", def: "The environment, expectations, and experiences that shape how people show up." },
  { name: "Behavior", def: "The daily choices, actions, and habits that determine execution." },
  { name: "Results", def: "The performance created through consistent behaviors and shared accountability." },
  { name: "Valuation", def: "The organizational value created by stronger people, more reliable execution, and less dependency on any one individual." }
];
const cx = 280, cy = 280, R = 152, r = 112;
const rad = (deg: number) => (deg * Math.PI) / 180;
const f = (n: number) => n.toFixed(1);
// Leadership at the top, then clockwise: -90, -18, 54, 126, 198 degrees.
const angles = [-90, -18, 54, 126, 198];
const rings = angles.map((a) => ({ x: cx + R * Math.cos(rad(a)), y: cy + R * Math.sin(rad(a)) }));
// Each name sits inside its ring where it keeps the most room from every ring's stroke and the centre disc
// (measured with the names at their phone size, 22 units with .12em tracking: at least 23 units clear of any
// line; 21 at the landscape phone size, 23 units), so at every width no letter touches a ring.
const labels = [
  [280, 110],
  [439, 253],
  [391, 411],
  [169, 411],
  [123, 254]
];
// The orbit: radius 282 about the centre, from -119 to 227 degrees clockwise,
// 18 px outside the rings' outer edge; the five ring angles fall at 8, 29, 50,
// 71 and 92 per cent of its length, under the engine's row thresholds.
const oR = 282, a0 = rad(-119), a1 = rad(227);
const sx = cx + oR * Math.cos(a0), sy = cy + oR * Math.sin(a0);
const ex = cx + oR * Math.cos(a1), ey = cy + oR * Math.sin(a1);
const orbit = `M${f(sx)} ${f(sy)} A${oR} ${oR} 0 1 1 ${f(ex)} ${f(ey)}`;
// The arrowhead at the orbit's end, along the clockwise tangent.
const tx = -Math.sin(a1), ty = Math.cos(a1);
const nx = Math.cos(a1), ny = Math.sin(a1);
const head = [
  [ex + tx * 7, ey + ty * 7],
  [ex - tx * 4 + nx * 5, ey - ty * 4 + ny * 5],
  [ex - tx * 4 - nx * 5, ey - ty * 4 - ny * 5]
].map(([x, y]) => `${f(x)},${f(y)}`).join(" ");
---
<div class="io-phil-draw rise-obj" style="--d:.2s">
  <div class="io-phil-box">
    <svg class="io-phil-svg" viewBox="-20 -20 600 600" role="img" aria-label="Five linked circles around IOS: Leadership, Culture, Behavior, Results and Valuation." data-draw="enter" focusable="false">
      {rings.map((p, i) => (
        <circle class="draw-line io-ring-line" cx={f(p.x)} cy={f(p.y)} r={r} style={`--d:${(i * 0.14).toFixed(2)}s;--dur:1400ms`}></circle>
      ))}
      <circle class="io-core-pulse" cx={cx} cy={cy} r="62" aria-hidden="true"></circle>
      <circle class="io-core" cx={cx} cy={cy} r="62"></circle>
      <circle class="draw-line io-core-ring" cx={cx} cy={cy} r="62" style="--d:.7s;--dur:1400ms"></circle>
      {nodes.map((n, i) => (
        <text class="ring-name" x={labels[i][0]} y={labels[i][1]} text-anchor="middle" style={`--d:${(i * 0.14).toFixed(2)}s`}>{n.name.toUpperCase()}</text>
      ))}
      <text class="io-core-word" x={cx} y={cy + 12} text-anchor="middle">IOS</text>
    </svg>
    <svg class="io-phil-svg io-phil-orbit" viewBox="-20 -20 600 600" data-draw="scroll" data-draw-rows="5" data-draw-for="#phil-rows" aria-hidden="true" focusable="false">
      <path class="draw-line" d={orbit}></path>
      <polygon class="draw-head" points={head}></polygon>
    </svg>
  </div>
</div>
<div class="io-phil-legend">
  <p class="t-folio io-phil-line rise">Leadership → Culture → Behavior → Results → Valuation</p>
  <ol id="phil-rows" class="loop-rows io-phil-rows">
    {nodes.map((n) => (
      <li class="loop-row">
        <p class="t-title">{n.name}</p>
        <p class="t-body">{n.def}</p>
      </li>
    ))}
  </ol>
</div>
<style>
  .io-phil-box { position: relative; width: 100%; aspect-ratio: 1 / 1; }
  .io-phil-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .io-ring-line { fill: none; stroke: #4f6d8c; stroke-width: 1.1; }
  .io-core { fill: #4f6d8c; }
  .io-core-ring { fill: none; stroke: #8aa3bf; stroke-width: 1.4; }
  /* The names take the page's soft text colour (soft steel on navy) until their ring lights, then its text colour
   * (cream), so when the page cross fades to cream with the drawing's foot still in view they turn slate and ink
   * instead of vanishing. The centre word sits on the steel disc and stays cream. */
  /* The names in user units, sized per layout so they render at 12 px or more: the drawing is 5 columns wide on
   * laptops (477 to 542 px), 5 of a tablet's (381), 8 of a narrow tablet's (464) and the full phone column (335 to 390). */
  .ring-name { font-family: var(--font-sans); font-size: 15.5px; font-weight: 600; letter-spacing: .12em; fill: var(--fg-3); transition: fill .5s var(--ease); }
  .io-core-word { font-family: var(--font-display); font-size: 34px; font-weight: 360; fill: #f2ece0; }
  .io-phil-orbit .draw-line { fill: none; stroke: #8aa3bf; stroke-width: 1; stroke-linecap: round; }
  .io-phil-orbit .draw-head { fill: #8aa3bf; }
  /* Each name fades in once its ring has finished drawing. */
  :global(.js) .ring-name { opacity: 0; transition: opacity .4s var(--ease) calc(var(--d, 0s) + 1.2s), fill .5s var(--ease); }
  :global(.js) .io-phil-svg.in .ring-name { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { :global(.js) .ring-name { opacity: 1; transition: none; } }
  @media (max-width: 1068px) { .ring-name { font-size: 20px; } }
  @media (max-width: 899px) { .ring-name { font-size: 16px; } }
  @media (max-width: 734px) { .ring-name { font-size: 22px; } .io-core-word { font-size: 40px; } }
  @media (max-width: 1068px) and (max-height: 500px) and (orientation: landscape) { .ring-name { font-size: 23px; } }
</style>
<style is:global>
  /* The drawing in motion. Lit by the legend's rows (the scroll engine lights row k as the orbit passes ring k). */
  .io-ring-line { transition: stroke .6s var(--ease), stroke-width .6s var(--ease); }
  .io-phil-grid:has(#phil-rows > li:nth-child(1).on) .io-ring-line:nth-of-type(1) { stroke: #8aa3bf; stroke-width: 1.8; }
  .io-phil-grid:has(#phil-rows > li:nth-child(1).on) .ring-name:nth-of-type(1) { fill: var(--fg); }
  .io-phil-grid:has(#phil-rows > li:nth-child(2).on) .io-ring-line:nth-of-type(2) { stroke: #8aa3bf; stroke-width: 1.8; }
  .io-phil-grid:has(#phil-rows > li:nth-child(2).on) .ring-name:nth-of-type(2) { fill: var(--fg); }
  .io-phil-grid:has(#phil-rows > li:nth-child(3).on) .io-ring-line:nth-of-type(3) { stroke: #8aa3bf; stroke-width: 1.8; }
  .io-phil-grid:has(#phil-rows > li:nth-child(3).on) .ring-name:nth-of-type(3) { fill: var(--fg); }
  .io-phil-grid:has(#phil-rows > li:nth-child(4).on) .io-ring-line:nth-of-type(4) { stroke: #8aa3bf; stroke-width: 1.8; }
  .io-phil-grid:has(#phil-rows > li:nth-child(4).on) .ring-name:nth-of-type(4) { fill: var(--fg); }
  .io-phil-grid:has(#phil-rows > li:nth-child(5).on) .io-ring-line:nth-of-type(5) { stroke: #8aa3bf; stroke-width: 1.8; }
  .io-phil-grid:has(#phil-rows > li:nth-child(5).on) .ring-name:nth-of-type(5) { fill: var(--fg); }
  /* All five lit: a brightening walks round the rings, Leadership to Valuation, one every 1.6 s (soft steel to pale
   * and back, a heavier line at its peak). */
  @keyframes io-ring-walk { 0%, 24%, 100% { stroke: #8aa3bf; stroke-width: 1.8; } 10% { stroke: #e6e7ea; stroke-width: 2.6; } }
  .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line { animation: io-ring-walk 8s var(--ease) infinite; }
  .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line:nth-of-type(2) { animation-delay: 1.6s; }
  .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line:nth-of-type(3) { animation-delay: 3.2s; }
  .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line:nth-of-type(4) { animation-delay: 4.8s; }
  .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line:nth-of-type(5) { animation-delay: 6.4s; }
  /* The centre breathes: a soft steel ring leaves the disc and fades, every 3.2 s, once the drawing is in. */
  .io-core-pulse { fill: none; stroke: #8aa3bf; stroke-width: 1.2; opacity: 0; transform-box: fill-box; transform-origin: center; }
  @keyframes io-core-pulse { 0% { opacity: .7; transform: scale(1); } 100% { opacity: 0; transform: scale(1.7); } }
  .js .io-phil-svg.in .io-core-pulse { animation: io-core-pulse 3.2s cubic-bezier(.2, .6, .3, 1) 1.8s infinite; }
  @media (prefers-reduced-motion: reduce) {
    .io-ring-line { transition: none; }
    .io-phil-grid:has(.io-phil-orbit.done) .io-ring-line, .js .io-phil-svg.in .io-core-pulse { animation: none; }
  }
</style>
