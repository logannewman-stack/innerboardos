---
/* The InnerBoard OS logo (the client's file, October 21): the steel circle with OS and INNERBOARD, cut from its PNG into public/brand. */
interface Props { class?: string; href?: string; label?: string; sub?: string; size?: number }
const { class: className = "", href = "/", label = "InnerBoard", sub = "IOS", size = 40 } = Astro.props;
---
<a href={href} class={`inline-flex items-center gap-2.5 ${className}`} aria-label={`${label} ${sub}, home`}>
  <img src="/brand/logo.png" width="442" height="442" alt="" aria-hidden="true" class="brand-os" style={`width:${size}px;height:${size}px`} />
  <span class="font-display text-[21px] leading-none tracking-[-0.01em] font-normal">
    {label}<span class="font-sans font-semibold text-[12px] tracking-[0.14em] uppercase align-middle ml-2 opacity-80">{sub}</span>
  </span>
</a>
