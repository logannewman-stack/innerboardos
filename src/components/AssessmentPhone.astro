---
/**
 * The Company OS Score, as it is taken on a phone. The statements are the
 * book's own (the owner's side of the Team OS Score table). Labelled
 * illustrative: the real assessment lives in Practice.
 */
const items = [
  ["Investing in People", "Developing our people is something we protect, not the first thing we cut when things get tight.", 7],
  ["What People Own", "Our people own outcomes rather than task lists, and they decide how to get there.", 5],
  ["Clear Wins", "Every person can tell you what a great job looks like in their role, what number they own, and why it matters.", 6],
  ["Living Agreements", "We have specific, spoken agreements about how we work together, and we hold each other to them.", 4]
];
---
<div class="phone" aria-hidden="true">
  <div class="phone-screen">
    <div class="phone-notch"></div>
    <div class="px-5 pt-14 pb-6 text-[12px]">
      <p class="text-[9.5px] font-semibold uppercase tracking-[0.16em] text-steel">Chapter 1 · Start here</p>
      <p class="mt-1 font-display text-[20px] leading-[1.1] tracking-[-0.02em]">Company OS Score</p>
      <p class="mt-1 text-[10.5px] text-app-muted">Ten statements. Score what is true of your company today.</p>
      <div class="mt-3 h-[5px] rounded-full bg-app-line overflow-hidden"><div class="h-full w-[40%] rounded-full bg-steel"></div></div>
      <ul class="mt-3 space-y-2">
        {items.map(([name, text, score], i) => (
          <li class={`rounded-[12px] border border-app-line px-3 py-2.5 ${i === 3 ? "bg-steel-soft" : "bg-app-surface"}`}>
            <p class="text-[9.5px] font-semibold uppercase tracking-[0.12em] text-steel">{name}</p>
            <p class="mt-1 text-[10.5px] leading-snug text-app-ink">{text}</p>
            <div class="mt-2 flex gap-[3px]">
              {Array.from({ length: 10 }, (_, n) => (
                <span class={`h-[14px] flex-1 rounded-[3px] ${n < (score as number) ? "bg-steel" : "bg-app-line"}`}></span>
              ))}
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-3 inline-flex items-center rounded-full bg-app-ink text-app-canvas px-3.5 py-1.5 text-[11px] font-semibold">Get my results</div>
    </div>
  </div>
</div>
