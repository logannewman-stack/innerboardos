---
/**
 * The hero's visual: the Company OS Score, as it reads once scored, drawn
 * and labelled illustrative. It stands where the brief's executive
 * photograph goes until an approved image is supplied.
 */
const rows = [
  { label: "Investing in People", score: 7 },
  { label: "What People Own", score: 5 },
  { label: "Clear Wins", score: 6 },
  { label: "Living Agreements", score: 4 },
  { label: "The Business Without Me", score: 3 }
];
---
<div class="scorecard card bg-cream-3 text-ink p-6 sm:p-7 w-full max-w-[460px] relative" aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Company OS Score</p>
      <p class="mt-1 text-[12.5px] text-ink-faint font-medium">Illustrative. Yours is scored from your answers.</p>
    </div>
    <span class="text-[10.5px] font-semibold uppercase tracking-[0.12em] rounded-full bg-gold-soft/60 text-gold-ink px-2.5 py-1">In transition</span>
  </div>
  <div class="mt-6 flex items-center gap-6">
    <div class="relative w-[128px] h-[128px] shrink-0">
      <svg viewBox="0 0 120 120" class="w-full h-full -rotate-90">
        <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-cream-2)" stroke-width="10" />
        <circle class="gauge" cx="60" cy="60" r="52" fill="none" stroke="var(--color-gold)" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="font-display text-[38px] leading-none font-medium tracking-tight tabular-nums" data-count="54">54</span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-faint mt-1">of 100</span>
      </div>
    </div>
    <div class="min-w-0">
      <p class="font-display text-[22px] leading-[1.15] font-medium">A gap you can name.</p>
      <p class="mt-2 text-[13.5px] text-ink-muted leading-snug">Ten categories. Where self-leadership holds, where it slips, and what closes each gap.</p>
    </div>
  </div>
  <ul class="mt-6 space-y-3">
    {rows.map((row, i) => (
      <li>
        <div class="flex items-center justify-between text-[13px]">
          <span class="font-medium text-ink">{row.label}</span>
          <span class="font-semibold text-ink-muted tabular-nums" data-count={String(row.score)}>{row.score}</span>
        </div>
        <div class="mt-1.5 h-[6px] rounded-full bg-cream-2 overflow-hidden">
          <div class="bar h-full rounded-full bg-navy" style={`--w:${row.score * 10}%; --d:${300 + i * 120}ms`}></div>
        </div>
      </li>
    ))}
  </ul>
  <div class="mt-6 pt-5 border-t border-line flex items-center justify-between">
    <span class="text-[12.5px] font-medium text-ink-faint">Company OS Gap Report</span>
    <span class="text-[12.5px] font-semibold text-gold-ink">Sent to your inbox</span>
  </div>
</div>
<style>
  .scorecard { box-shadow: var(--shadow-float); }
  .gauge { transition: stroke-dashoffset 1600ms var(--ease-out) 300ms; }
  :global(.is-in) .gauge, :global(.no-js) .gauge { stroke-dashoffset: 46; }
  .bar { width: 0; transition: width 1200ms var(--ease-out); transition-delay: var(--d); }
  :global(.is-in) .bar, :global(.no-js) .bar { width: var(--w); }
  @media (prefers-reduced-motion: reduce) { .bar { width: var(--w); transition: none; } .gauge { transition: none; stroke-dashoffset: 46; } }
</style>
