---
/**
 * Diagram 2, the workflow, as a scroll story on the step layout (SCROLL_SPEC
 * S10, STORY_V2 3.7). The five steps of the workflow are the story's steps:
 * while the reader scrolls, the stage stays under the header, the device is
 * pinned at the left with the rail and its "01 / 05" counter, and one step's
 * label (as the eyebrow), lead (the headline) and body show at a time at the
 * right, changing with the screen. On a laptop a browser window: the cursor
 * clicks the Company OS Score's "See what ... means" bar and the result
 * wipes up (Assess), clicks InnerBoard OS in the rail and rests on the
 * Personal and then the Social leadership modules of the Track while
 * Develop's text gives way to Personal Power and then Social Influence (the
 * group label "02. Develop" stays as their eyebrow), clicks Tools for the
 * Role Blueprint filled in for one role (Embed), and goes back to the
 * Track's status column (Measure); Certify changes only its copy (no capture
 * shows certification honestly). On tablets and phones a phone does the same
 * story. The locked line "Assess → Develop → Embed → Measure → Certify" is
 * no longer the progress control: the page sets it under the statement that
 * follows the story.
 *
 * The window is the step layout's window (700 at 1440, at most 888 from
 * 1800); its caption follows the frame under it.
 *
 * Static (no script, reduced motion, a landscape phone, a short laptop
 * window): the five steps in order, each with its own screen (a window above
 * 734, a phone below), Develop's two items under it.
 */
import WindowFrame from "./WindowFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import StoryMarks from "./StoryMarks.astro";

const caps = [
  "The Company OS Score, scored on a desk.",
  "What the score means: the reading, and the chapters that answer the lowest statements.",
  "The Track inside Practice: the modules under Personal leadership and Social leadership.",
  "The Role Blueprint, filled in for one role."
];
const win = [
  { name: "desk-score-upstream-scored", alt: caps[0], x2: true },
  { name: "desk-score-upstream-result", alt: caps[1], x2: true },
  { name: "desk-track-home", alt: caps[2], x2: true },
  { name: "desk-leader-blueprint", alt: caps[3], x2: true }
];
const phone = [
  { name: "score-upstream-scored", alt: "The Company OS Score on a phone: statements scored on the ten point scale, and the button that shows what the score means.", w: 780, h: 1688 },
  { name: "score-upstream-result", alt: "What the score means on a phone: the three lowest statements and the chapter that answers each.", w: 780, h: 1688,
    strip: { next: "score-upstream-result-2", at: 89.23, head: 6.2 } },
  { name: "track-home", alt: "The Track on a phone: the modules under Personal leadership and Social leadership.", w: 780, h: 1688 },
  { name: "leader-blueprint", alt: "The Role Blueprint on a phone, filled in for one role.", w: 780, h: 1688 }
] as const;
const steps = [
  { label: "01. Assess.", lead: "Understand your people and where the opportunities exist.", body: "Identify current strengths, development opportunities, role expectations, and what influences performance. Create greater clarity about where your team is today and what needs to develop next.",
    w: 1.2, win: 1, phone: 1, off: 89.23,
    alt: "The Company OS Score scored on a desk; the cursor opens what the score means, and rests on the three lowest statements and the chapters that answer them.",
    act: '{"win":{"f":0,"cur":[[.08,40,60],[.34,58.6,95.7],[.6,58.6,95.7],[.82,52,47]],"click":.42,"next":[.46,1]},"phone":{"f":0,"tap":[50,95.6,.36],"next":[.4,1],"scroll":[.56,.86,0,89.23]}}' },
  { label: "02. Develop.", lead: "Build the self-leadership skills and capacity your business needs.", body: "Give people practical development that strengthens how they think, communicate, solve problems, take ownership, and lead themselves. Help every person grow into the demands and opportunities of their role.",
    w: 1.6, win: 2, phone: 2,
    alt: "The Track: the modules under Personal leadership, then the modules under Social leadership.",
    act: '{"win":{"cur":[[.06,52,47],[.22,5,23.6],[.3,5,23.6],[.42,45,24.5],[.6,45,24.5],[.72,45,69.5]],"click":.26,"next":[.3,2],"sub":[[.42,1],[.72,2]]},"phone":{"f":2,"cam":[[.1,1,50,50],[.3,1.06,50,34],[.58,1.06,50,34],[.74,1.06,50,74],[.9,1,50,50]],"sub":[[.42,1],[.72,2]]}}' },
  { label: "03. Embed.", lead: "Turn learning into everyday behavior.", body: "Development doesn't create value simply because someone completes a course. It creates value when people apply what they've learned. InnerBoard IOS brings development into daily work through intentional practice, clear expectations, and consistent application.",
    w: 1, win: 3, phone: 3,
    alt: "The Role Blueprint, filled in for one role: what the role is paid to produce.",
    act: '{"win":{"cur":[[.08,45,69.5],[.28,5,33.3],[.46,5,33.3],[.7,50,59.5]],"click":.36,"next":[.4,3]},"phone":{"f":3,"cam":[[.12,1,50,50],[.38,1.06,50,76],[.7,1.06,50,76],[.88,1,50,50]]}}' },
  { label: "04. Measure.", lead: "Track curriculum progress through module completion.", body: "Leaders can see how many modules each person has completed. Individual answers, reflections, and written responses remain private.",
    w: 1, win: null, phone: null,
    alt: "The Track again, with each module's own status: up next, or take it.",
    act: '{"win":{"cur":[[.08,50,59.5],[.28,5,23.6],[.46,5,23.6],[.7,81,24.5]],"click":.36,"next":[.4,2]},"phone":{"f":2}}' },
  { label: "05. Certify.", lead: "Develop leaders who can sustain and scale the work.", body: "Build internal strength through trained and certified leaders who can reinforce the methodology, support their teams, and help sustain a culture of development.",
    w: 1, win: null, phone: null,
    alt: "The Track holds.",
    act: '{"win":{},"phone":{}}' }
];
---
<div class="story io-wf-story" data-story="workflow" data-story-ui="steps" data-side="left" data-kind="win" data-story-h="s" data-warm style="--story-w:5.8;--step-l:64svh;--step-l-n:58svh">
  <div class="story-track">
    <div class="story-stage">
      <div class="story-device-col">
        <StoryMarks variant="rail" labels={steps.map((s) => s.lead)} label="The InnerBoard IOS workflow, step by step" />
        <div class="story-device-box io-wf-box">
          <!-- Laptops: the desk window and its caption. -->
          <div class="story-win io-wf-win">
            <WindowFrame device="win" ww={888} label="InnerBoard IOS on a desk, step by step." screens={win} />
            <div class="win-caps io-wf-caps">
              {caps.map((c, i) => <p class={`win-cap t-cap-i${i === 0 ? " on" : ""}`} data-cap={i}>{c}</p>)}
            </div>
          </div>
          <!-- Tablets and phones: the phone. -->
          <div class="story-phone io-wf-phone" style="--pw-max-n:240px">
            <PhoneFrame device="phone" width={240} style="--pw:inherit" label="InnerBoard IOS on a phone, step by step." screens={[...phone]} />
          </div>
        </div>
      </div>
      <div class="story-copy io-wf-copy">
        <ol class="story-steps io-wf-steps" role="list">
          {steps.map((s, i) => (
            <li class={`story-step${i === 1 ? " io-wf-has-sub" : ""}`} data-step={i} data-w={s.w !== 1 ? s.w : undefined} data-act={s.act}>
              {i === 1 ? (
                <Fragment>
                  <div class="story-sub io-wf-text" data-sub="0">
                    <p class="t-folio io-wf-label story-eyebrow">{s.label}</p>
                    <p class="t-title io-wf-lead story-h">{s.lead}</p>
                    <p class="t-body io-wf-body story-body">{s.body}</p>
                  </div>
                  <div class="story-subs io-wf-develop">
                    <i class="io-wf-dev-rule" aria-hidden="true"></i>
                    <p class="t-folio io-wf-dev-label story-eyebrow">02. Develop</p>
                    <div class="story-sub io-wf-dev-item" data-sub="1">
                      <p class="t-title io-wf-dev-name story-h">Personal Power</p>
                      <p class="t-body io-wf-dev-body story-body">How we lead ourselves. Build the awareness, confidence, and emotional capacity to make intentional choices, take ownership, and follow through.</p>
                    </div>
                    <div class="story-sub io-wf-dev-item" data-sub="2">
                      <p class="t-title io-wf-dev-name story-h">Social Influence</p>
                      <p class="t-body io-wf-dev-body story-body">How we co-create results with and through other people. Strengthen communication, trust, collaboration, and the ability to positively influence shared outcomes.</p>
                    </div>
                  </div>
                </Fragment>
              ) : (
                <div class="io-wf-text">
                  <p class="t-folio io-wf-label story-eyebrow">{s.label}</p>
                  <p class="t-title io-wf-lead story-h">{s.lead}</p>
                  <p class="t-body io-wf-body story-body">{s.body}</p>
                </div>
              )}
              <span class="sr-only story-alt">{s.alt}</span>
              {s.win !== null && (
                <div class="story-static io-wf-fig">
                  <div class="static-desk">
                    <WindowFrame ww={640} screens={[win[s.win]]} />
                    <p class="t-cap-i io-wf-fig-cap">{caps[s.win]}</p>
                  </div>
                  <div class="static-phone">
                    <PhoneFrame width={180} screens={[phone[s.phone!]]} off={s.off} />
                  </div>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="story-run" aria-hidden="true"></div>
  </div>
</div>
