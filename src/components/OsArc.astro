---
/**
 * The InnerBoard OS logo's open arc (the client's logo, October 21), as a drawing the page can place at any size:
 * one even stroke on a circle, open at the lower right where the logo sets INNERBOARD round its edge. Measured from
 * public/brand/logo.png: the stroke's centre line is 180 of the 442 px file's 221 px radius, 8 px wide, from 105 to
 * 350 degrees (clockwise from three o'clock). It replaces the earlier drawn ring and crosshair (Geo) as the brand
 * device behind sections and round the hero's phone.
 *
 * It draws itself in from its lower end when it arrives (the motion library's drawn lines, data-draw="enter");
 * reduced motion and no script show it drawn. Place it with your own class (absolute: right, top, ...), or with `cx`
 * and `cy` (CSS lengths for the circle's centre in the positioned parent). `size` is the drawing's box, in px or as
 * any CSS length; `weight` scales the stroke (1 is the logo's own); `turn` rotates it.
 */
interface Props {
  size?: number | string;
  color?: string;
  opacity?: number;
  weight?: number;
  turn?: number;
  cx?: string;
  cy?: string;
  class?: string;
  style?: string;
  draw?: boolean;
}
const { size = 900, color = "#e4b676", opacity = 1, weight = 1, turn = 0, cx, cy, class: className = "", style = "", draw = true } = Astro.props;
const R = 180;
const W = 8 * weight;
const rad = (d: number) => (d * Math.PI) / 180;
const pt = (d: number) => `${(R * Math.cos(rad(d))).toFixed(2)} ${(R * Math.sin(rad(d))).toFixed(2)}`;
const a0 = 105, a1 = 350;
const d = `M${pt(a0)}A${R} ${R} 0 1 1 ${pt(a1)}`;
const box = R + W;
const len = typeof size === "number" ? `${size}px` : size;
const place = [
  cx != null ? `left:calc(${cx} - var(--arc-size) / 2)` : "",
  cy != null ? `top:calc(${cy} - var(--arc-size) / 2)` : ""
].filter(Boolean).map((v) => v + ";").join("");
---
<svg class={`os-arc ${className}`.trim()} viewBox={`${-box} ${-box} ${2 * box} ${2 * box}`}
  style={`--arc-o:${opacity};--arc-size:${len};--dur:1800ms;${place}${style}`}
  data-geo={draw ? "" : undefined} data-draw={draw ? "enter" : undefined} aria-hidden="true" focusable="false">
  <path class={draw ? "draw-line" : undefined} d={d} transform={turn ? `rotate(${turn})` : undefined} fill="none" stroke={color} stroke-width={W} stroke-linecap="butt" />
</svg>
