      <stop offset="0" stop-color="#0d1a2d" />
      <stop offset="1" stop-color="#1b3052" />
    </linearGradient>
    <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c9ab66" stop-opacity="0.55" />
