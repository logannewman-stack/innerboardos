---
/**
 * The colophon (IOS_SPEC 1.7) on the system's markup and classes (BUILD_SPEC
 * 1.9). Painted linen; it carries data-tone="cream" so the page returns to
 * cream after the navy close. The IOS wordmark and the brief's closing line,
 * the founder credit (the one mention in the footer), the three columns, the
 * legal row.
 */
import Wordmark from "./Wordmark.astro";
import { LINKS, SITE } from "../config/links";
const year = new Date().getFullYear();
---
<footer class="site-footer" data-tone="cream">
  <div class="wrap">
    <div class="ftr-top rise">
      <div class="ftr-blurb-col">
        <Wordmark />
        <p class="ftr-blurb">The people operating system for <span style="white-space:nowrap">high-performing</span> organizations.</p>
      </div>
      <p class="ftr-founder">Founded by {SITE.founder}.</p>
    </div>
    <div class="ftr-rule rule-draw" aria-hidden="true"></div>
    <div class="ftr-cols">
      <nav class="ftr-col" id="site-nav" aria-label="Footer, on this site">
        <p class="eyebrow">On this site</p>
        <ul>
          <li><a href="/#ios">What IOS is</a></li>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#book">The book</a></li>
          <li><a href="/#impact">Impact</a></li>
          <li><a href="/#who-its-for">Who it's for</a></li>
          <li><a href="/#partners">Partners</a></li>
        </ul>
      </nav>
      <nav class="ftr-col" aria-label="Footer, contact">
        <p class="eyebrow">Contact</p>
        <ul>
          <li><a href={LINKS.talk} data-event="consultation_click" data-event-location="footer">Talk to our team</a></li>
          <li><a href={`mailto:${LINKS.contactEmail}`}>{LINKS.contactEmail}</a></li>
          <li><a href={LINKS.score} data-passthrough data-event="assessment_click" data-event-location="footer">Get your Company OS Score</a></li>
        </ul>
      </nav>
      <nav class="ftr-col ftr-col-wide" aria-label="Footer, InnerBoard">
        <p class="eyebrow">InnerBoard</p>
        <ul>
          <li><a href={LINKS.suite}>InnerBoardSuite.com</a></li>
          <li><a href={LINKS.practice}>Practice</a></li>
          <li><a href={LINKS.academy}>Academy</a></li>
          <li><a href={LINKS.inq}>INQ Certification</a></li>
        </ul>
      </nav>
    </div>
    <div class="ftr-legal">
      <p>&copy; {year} InnerBoard. All rights reserved.</p>
      <nav aria-label="Legal">
        <a href={LINKS.privacy}>Privacy policy</a>
        <a href={LINKS.terms}>Terms</a>
      </nav>
    </div>
  </div>
</footer>
