const paths: Record<string, string> = {
  people: "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5M15 15.2c3.3.3 7 2 7 4.8",
  sun: "M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z",
  bars: "M4 20h16M7 16V9M12 16V5M17 16v-7",
  own: "M5 12h4l2-5 3 10 2-5h3M4 20h16",
  check: "M4 7h10M4 12h7M4 17h9M15 16l2.5 2.5L22 14",
  up: "M12 20V5M6 11l6-6 6 6",
  door: "M5 21V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v17M11 12h.01M5 21h14M15 7h4v14",
  culture: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9c0-3.5 3.6-6 8-6s8 2.5 8 6M3 11a3 3 0 1 0 0-6M21 11a3 3 0 1 1 0-6",
  diamond: "M7 3h10l4 6-9 12L3 9l4-6Zm-4 6h18M9 3l3 6 3-6M12 9l-3 12M12 9l3 12"
};
const d = paths[name] || "";
---
<svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d}></path></svg>
