---
/**
 * The header (IOS_SPEC 1.6) on the system's markup and classes (BUILD_SPEC
 * 1.8): fixed, transparent at the top, frosted after 24 px, dark over navy
 * (1.7.6), hidden on scroll down. The IOS wordmark, the five anchor links
 * (no sub labels), the gold Company OS Score pill. Below 1069 px the links
 * collapse to the burger and a full screen sheet (rendered after the header
 * so neither the blur nor the hide transform contains it) with the two
 * full width buttons at its foot. The sheet paints cream on every page tone,
 * so it carries the light surface's tokens (data-surface="light"). Without
 * the script the burger cannot open it: the same two lines are then a link
 * to the footer's list of the site's sections.
 */
import Wordmark from "./Wordmark.astro";
import Arrow from "./Arrow.astro";
import { LINKS } from "../config/links";
const nav = [
  { href: "/#ios", label: "What IOS is" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#book", label: "The book" },
  { href: "/#impact", label: "Impact" },
  { href: "/#partners", label: "Partners" }
];
---
<header data-header class="site-header">
  <div class="wrap">
    <div class="hdr-row">
      <Wordmark />
      <nav aria-label="Primary" class="hdr-links">
        {nav.map((item) => <a href={item.href} class="hdr-link">{item.label}</a>)}
        <a href={LINKS.score} class="btn btn-sm btn-gold hdr-cta" data-passthrough data-event="assessment_click" data-event-location="header">Get Your Company OS Score <Arrow /></a>
      </nav>
      <button type="button" class="hdr-burger" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><i></i><i></i></button>
      <a href="#site-nav" class="hdr-burger hdr-nojs" aria-label="Menu: the site's sections, in the footer"><i></i><i></i></a>
    </div>
  </div>
</header>
<div id="mobile-menu" data-menu-panel class="menu-panel" data-surface="light">
  <nav aria-label="Primary, mobile" class="wrap menu-nav">
    {nav.map((item, i) => <a href={item.href} class="menu-link" style={`--i:${i}`}>{item.label}</a>)}
    <div class="menu-cta menu-link" style="--i:5">
      <a href={LINKS.talk} class="btn btn-line" data-event="consultation_click" data-event-location="mobile-menu">Talk to Our Team</a>
      <a href={LINKS.score} class="btn btn-gold" data-passthrough data-event="assessment_click" data-event-location="mobile-menu">Get Your Company OS Score <Arrow /></a>
    </div>
  </nav>
</div>
<style>
  /* The sheet's two full width buttons sit 10 px apart (the system's .menu-cta stacks them with the link gap of 6). */
  .menu-cta { gap: 10px; }
</style>
